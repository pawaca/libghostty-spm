+        // The app thread cannot drain while it joins a closing surface.
+        // Preserve normal delivery, but make the wait cancellable by teardown.
+        while (true) {
+            if (self.surface.closing.load(.acquire)) {
+                msg.discard();
+                // Consumed: instant-then-forever callers must not retry an
+                // owned payload that has already been released.
+                return 1;
+            }
+            const result = self.app.push(.{
+                .surface_message = .{
+                    .surface = self.surface,
+                    .message = msg,
+                },
+            }, switch (timeout) {
+                .forever => .{ .ns = 10 * std.time.ns_per_ms },
+                else => timeout,
+            });
+            if (result != 0 or timeout != .forever) return result;
+        }
     }
 };
 
