+
+test "closing surface consumes owned messages without app callbacks" {
+    var surface: Surface = undefined;
+    surface.closing = .init(true);
+    const mailbox: Mailbox = .{ .surface = &surface, .app = undefined };
+    const payload = try Message.WriteReq.init(std.testing.allocator, @as([]const u8, "x" ** 1024));
+    try std.testing.expectEqual(@as(App.Mailbox.Queue.Size, 1), mailbox.push(.{ .pwd_change = payload }, .forever));
+    try std.testing.expectEqual(@as(App.Mailbox.Queue.Size, 1), mailbox.push(.ring_bell, .instant));
+}
+
+test "closing surface cancels a producer waiting on a full app mailbox" {
+    if (comptime build_config.app_runtime != .none) return error.SkipZigTest;
+    const Worker = struct {
+        fn run(mailbox: Mailbox, result: *App.Mailbox.Queue.Size) void {
+            result.* = mailbox.push(.ring_bell, .forever);
+        }
+    };
+    var surface: Surface = undefined;
+    surface.closing = .init(false);
+    var rt_app: apprt.App = undefined;
+    var queue: App.Mailbox.Queue = .{};
+    for (0..64) |_| {
+        try std.testing.expect(queue.push(std.testing.io, .quit, .instant) != 0);
+    }
+    const mailbox: Mailbox = .{
+        .surface = &surface,
+        .app = .{ .rt_app = &rt_app, .mailbox = &queue },
+    };
+    var result: App.Mailbox.Queue.Size = 0;
+    const thread = try std.Thread.spawn(.{}, Worker.run, .{ mailbox, &result });
+    // Confirm the producer is actually waiting, rather than closing before
+    // it starts. The waiter count is protected by the queue mutex.
+    while (true) {
+        queue.mutex.lockUncancelable(std.testing.io);
+        const waiting = queue.not_full_waiters > 0;
+        queue.mutex.unlock(std.testing.io);
+        if (waiting) break;
+        try std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake);
+    }
+    surface.closing.store(true, .release);
+    thread.join();
+    try std.testing.expectEqual(@as(App.Mailbox.Queue.Size, 1), result);
+    try std.testing.expectEqual(@as(App.Mailbox.Queue.Size, 64), queue.len);
+}
